{
  "expo": {
    "name": "MIDI-eval Times",
    "slug": "player-piano-native",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "updates": {
      "url": "https://u.expo.dev/8285a4ab-c40f-48d8-a0ba-c1b37324ade6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": ["RECEIVE_BOOT_COMPLETED", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_AUDIO_PLAYBACK"],
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.corens.playerpianonative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8285a4ab-c40f-48d8-a0ba-c1b37324ade6"
      }
    },
    "owner": "corens",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
